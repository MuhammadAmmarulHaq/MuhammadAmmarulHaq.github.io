[
{% for post in site.posts %}{"title":{{ post.title | jsonify }},"slug":{{ post.slug | default: post.title | slugify | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: "%Y-%m-%d" | jsonify }},"category":{{ post.categories | first | default: "blog" | jsonify }},"tags":[{% for t in post.tags %}{{ t | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}],"description":{{ post.description | default: "" | jsonify }},"text":{{ post.content | strip_html | normalize_whitespace | truncate: 600 | jsonify }}}{% unless forloop.last %},
{% endunless %}{% endfor %}
]
